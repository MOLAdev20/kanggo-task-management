{
  "info": {
    "_postman_id": "f8e4c07a-24d0-4c65-8e3d-0d4a6d1a4f1b",
    "name": "Kanggo Task Management API",
    "description": "Postman collection untuk seluruh endpoint backend Kanggo Task Management. Jalankan Register atau Login terlebih dahulu agar token tersimpan otomatis.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "task_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/"
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Register berhasil', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.collectionVariables.set('token', json.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test-user@gmail.com\",\n  \"password\": \"password1234\"\n}"
            },
            "url": "{{base_url}}/api/auth/register",
            "description": "Membuat user baru. Token dari response disimpan otomatis ke variable collection."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login berhasil', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.collectionVariables.set('token', json.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test-user@gmail.com\",\n  \"password\": \"password1234\"\n}"
            },
            "url": "{{base_url}}/api/auth/login"
          }
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "List Tasks",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }],
            "url": {
              "raw": "{{base_url}}/api/tasks?limit=10&status=all&title=",
              "host": ["{{base_url}}"],
              "path": ["api", "tasks"],
              "query": [
                { "key": "limit", "value": "10", "description": "Jumlah item, 1-100. Default 10." },
                { "key": "cursor", "value": "", "description": "ID task dari halaman sebelumnya." },
                { "key": "status", "value": "all", "description": "all, pending, in-progress, atau done." },
                { "key": "title", "value": "", "description": "Pencarian berdasarkan judul." }
              ]
            }
          }
        },
        {
          "name": "Create Task",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    if (json.task && json.task.id) pm.collectionVariables.set('task_id', json.task.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Mengerjakan dokumentasi API\",\n  \"description\": \"Menulis dan menguji Postman collection\",\n  \"deadline\": \"2026-12-31\"\n}"
            },
            "url": "{{base_url}}/api/tasks"
          }
        },
        {
          "name": "Update Task",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Dokumentasi API selesai\",\n  \"description\": \"Deskripsi task telah diperbarui\",\n  \"deadline\": \"2026-12-31\",\n  \"status\": \"IN_PROGRESS\"\n}"
            },
            "url": "{{base_url}}/api/tasks/{{task_id}}"
          }
        },
        {
          "name": "Delete Task",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }],
            "url": "{{base_url}}/api/tasks/{{task_id}}"
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  }
}
